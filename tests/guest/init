#!/bin/sh
# PID 1 for the Solstice test guest.
#
# The guest is an initramfs: the kernel unpacks it into a writable rootfs and
# runs this. There is no disk, no bootloader and no fstab, so every boot is
# identical by construction -- which is the property the test harness wants
# and the main reason this is not a qcow2.
#
# Readiness is not signalled on a side channel. The harness polls
# `guest-exec xdpyinfo` over QMP: when that exits 0 the agent is up, X is up,
# and the guest is ready for a test. One mechanism, no race.

export PATH=/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
export HOME=/root

log() { echo "[init] $*" > /dev/console 2>&1; }

mount -t proc     -o nosuid,noexec,nodev proc   /proc
mount -t sysfs    -o nosuid,noexec,nodev sys    /sys
mount -t devtmpfs -o mode=0755,nosuid    dev    /dev
mkdir -p /dev/pts /dev/shm /run /tmp /var/log /root
mount -t devpts   -o gid=5,mode=620      devpts /dev/pts
mount -t tmpfs    -o nosuid,nodev        shm    /dev/shm

# `solstice.geometry=WxH` on the kernel command line picks the mode. The old
# Xspice harness had to write a whole xorg.conf per test to set this; here it
# is one substitution into a fixed config.
GEOMETRY=$(sed -n 's/.*solstice\.geometry=\([0-9]*x[0-9]*\).*/\1/p' /proc/cmdline)
[ -n "$GEOMETRY" ] || GEOMETRY=1280x720
sed -i "s/@GEOMETRY@/$GEOMETRY/" /etc/X11/xorg.conf
log "geometry $GEOMETRY"

# uinput is what spice-vdagentd injects absolute pointer events through;
# without it the daemon starts and then cannot do its job.
for m in qxl virtio_console virtio_pci evdev uinput; do modprobe "$m" 2>/dev/null; done

udevd --daemon 2>/dev/null
udevadm trigger --type=subsystems --action=add 2>/dev/null
udevadm trigger --type=devices --action=add 2>/dev/null
udevadm settle --timeout=10 2>/dev/null

# A serial console for when a test fails and the pixels are not the question.
setsid getty -L 115200 ttyS0 vt100 2>/dev/null &

qemu-ga --daemonize --method=virtio-serial \
        --path=/dev/virtio-ports/org.qemu.guest_agent.0 \
        --logfile=/var/log/qemu-ga.log 2>/dev/null
log "qemu-ga started"

X :0 -config /etc/X11/xorg.conf -nolisten tcp -keeptty vt1 \
    > /var/log/xorg.stdout 2>&1 &

for _ in $(seq 1 100); do
    [ -S /tmp/.X11-unix/X0 ] && break
    sleep 0.1
done
export DISPLAY=:0
log "X on $DISPLAY after $(cut -d' ' -f1 /proc/uptime)s"

# spice-vdagentd talks to the SPICE server over virtio-serial; spice-vdagent
# is its X client. Both are absent from the Xspice tier entirely -- the Debian
# launcher cannot start them -- so this is the part of the guest that buys the
# agent coverage in roadmap.md 2.7.
if [ -e /dev/virtio-ports/com.redhat.spice.0 ]; then
    # Three things this needs that are easy to get wrong, because the daemon
    # fails quietly on each: the uinput module above, a directory to put its
    # socket in, and a machine-id, without which its dbus proxy cannot start
    # and it falls back to guessing display ids. A fixed id is deliberate --
    # this guest is supposed to be identical on every boot.
    mkdir -p /run/spice-vdagentd
    [ -s /etc/machine-id ] || echo 5015713ce5a84f2d9d1a7f2c4b6e8a10 > /etc/machine-id
    # Both run in the foreground with debug logging, redirected to files. A
    # test guest has no syslog, and when a resize or a clipboard round-trip
    # fails these logs are the only account of why -- so they are worth
    # having unconditionally rather than behind a flag nobody remembers.
    spice-vdagentd -x -d > /var/log/vdagentd.log 2>&1 &
    sleep 0.5
    spice-vdagent -x -d > /var/log/vdagent.log 2>&1 &
    log "spice-vdagentd and spice-vdagent started"
else
    log "no spice vdagent port; agent not started"
fi

solstice-draw fill 000000
log "ready"

while :; do sleep 3600; done
